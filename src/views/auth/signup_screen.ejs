<% layout("layout/auth_layout.ejs") %>

<div class="login-container auth-reverse">
  <div class="left-login-section">
    <div class="brand-panel">
      <span class="eyebrow">Create Your Account</span>
      <h1>Join Atelier</h1>
      <p>
        Start your personalized shopping experience with curated collections,
        saved favorites, and a smoother checkout journey.
      </p>
      <div class="feature-list">
        <div class="feature-item">
          <span class="feature-icon">01</span>
          <div>
            <h3>Save What You Love</h3>
            <p>Build your wishlist and revisit standout pieces anytime.</p>
          </div>
        </div>
        <div class="feature-item">
          <span class="feature-icon">02</span>
          <div>
            <h3>Shop Faster</h3>
            <p>
              Keep your account ready for quicker ordering and easier tracking.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="right-login-section">
    <div class="login-form">
      <span class="form-tag">New Member</span>
      <h2>Create account</h2>
      <p class="form-intro">Enter your details below to get started.</p>

      <form class="form" action="/auth/signup" method="post">
        <label class="input-group">
          <span>Full Name</span>
          <input
            type="text"
            name="fullName"
            placeholder="Enter your full name"
            required
          />
        </label>

    
        <label class="input-group">
          <span>Email Address</span>
          <input
            type="email"
            name="email"
            placeholder="name@gmail.com"
            required
          />
        </label>
        <label class="input-group">
          <span>Phone</span>
          <input type="text" name="phone" placeholder="phone" required />
        </label>

        <label class="input-group">
          <span>Password</span>
          <input
            type="password"
            name="password"
            placeholder="Create a password"
            required
          />
        </label>

        <button type="submit" class="login-btn">Create Account</button>

        <p class="signup-copy">
          Already have an account?
          <a href="/auth/login" class="text-link">Sign in</a>
        </p>
      </form>
    </div>
  </div>
</div>
