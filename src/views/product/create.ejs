<% layout("layout/dashboard_layout.ejs") %>

<div class="site-shell">
  <main class="create-main">
    <section class="create-panel">
      <span class="eyebrow">List product</span>
      <h1><%= product ? "Edit product" : "Create a new product listing" %></h1>
      <p>Enter the product details and publish it for buyers to discover.</p>

      <form class="form-grid" action="<%= product ? "/product/create":`/product/edit/${product.id}?_method=PUT` %>" method="POST">
        <div class="input-group">
          <span>Product name</span>
          <input
            type="text"
            name="name"
            value="<%=product?  product.name:"" %>"
            placeholder="Enter product name"
            required
          />
        </div>
        <div class="input-group">
          <span>Price</span>
          <input
           value="<%= product ? product.price :" "%>"
            type="number"
            name="price"
            step="0.01"
            min="0"
            placeholder="0.00"
            required
          />
        </div>
        <div class="input-group">
          <span>Image URL</span>
          <input
            type="url"
            name="image"
            value="<%= product? product.image :""%>"
            placeholder="https://example.com/image.jpg"
          />
        </div>
        <div class="input-group input-fullwidth">
          <span>Description</span>
          <textarea
            name="description"
         
            placeholder="Write a short product description"
            required
          >    <%= product?  product.description :""%></textarea>
        </div>
       <% if (product) { %>
  <button class=" btn-primary"  type="submit">
    Edit Product
  </button>
<% } else { %>
  <button class="btn-primary" type="submit">
    Publish Product
  </button>
<% } %>

      </form
    </section>
  </main>

  <footer class="site-footer">
    <p>Once published, your item will appear in the shop for all users.</p>
  </footer>
</div>
